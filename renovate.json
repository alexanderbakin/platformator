{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tbilisi",
  "schedule": ["before 8am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "One pull request for the minor and patch updates of Go modules",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules (minor and patch)"
    },
    {
      "description": "One pull request for GitHub Actions, pinned by commit",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Kubernetes libraries move together with controller-runtime",
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "kubernetes libraries"
    }
  ],
  "customManagers": [
    {
      "description": "Tool versions in workflows, marked with a renovate comment above them",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+: (?<currentValue>\\S+)"
      ]
    }
  ]
}
