# Sealed Secrets: a controller that turns a SealedSecret from Git into an
# ordinary Secret. Its private key is not generated here, it is the one made by
# sealed-secrets/generate-key.sh and installed from 05-sealed-secrets-key.yaml,
# so a fresh node opens files sealed for an earlier one. The controller would
# otherwise add a new key every 30 days, so renewal is off: one key, kept by us.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: sealed-secrets
  namespace: kube-system
spec:
  repo: https://bitnami.github.io/sealed-secrets
  chart: sealed-secrets
{% if sealed_secrets_version != 'latest' %}
  version: "{{ sealed_secrets_version }}"
{% endif %}
  targetNamespace: kube-system
  valuesContent: |-
    # kubeseal looks for this name in kube-system.
    fullnameOverride: sealed-secrets-controller
    keyrenewperiod: "0"
    resources:
      requests:
        cpu: 20m
        memory: 64Mi
      limits:
        memory: 128Mi
