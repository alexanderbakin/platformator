apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
{% set acme_email = lookup('env', 'ACME_EMAIL') | default('', true) %}
{% if acme_email %}
    email: "{{ acme_email }}"
{% endif %}
    privateKeySecretRef:
      name: letsencrypt-account-key
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
