DOMAIN=example.com
# Optional: where images built from spec.source are pushed.
# REGISTRY=ghcr.io/your-github-name
# Only for a registry inside the cluster that serves plain HTTP (the e2e test).
# Never set it for a real registry: it turns TLS verification off for pushes.
# REGISTRY_INSECURE=true
# Optional: receive GitHub push webhooks on this address, so a push builds at
# once instead of within a minute. Needs the github-webhook Secret and
# make deploy-webhook (see the README, "Builds on push").
# GITHUB_WEBHOOK_ADDR=:8082
